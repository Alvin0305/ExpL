class
    doubler{
        decl
            int k;
            int twice(int x);
        enddecl

        int twice(int x){
            decl enddecl
            begin
                x = x * 2;
                return x;
            end
        }
    }
endclass

decl
    doubler d;
enddecl

int main(){
    decl
        int a;
    enddecl
    begin
        a = initialize();
        d = new(doubler);
        a = d.twice(21);
        write(a);
        return 0;
    end
}
