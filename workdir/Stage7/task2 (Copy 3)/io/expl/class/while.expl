class
    printer{
        decl
            int i;
            int run(int n);
        enddecl

        int run(int n){
            decl enddecl
            begin
                self.i = 1;
                while (self.i <= n) do
                    write(self.i);
                    self.i = self.i + 1;
                endwhile
                return 1;
            end
        }
    }
endclass

decl
    printer p;
enddecl

int main(){
    decl 
        int x;
    enddecl
    begin
        x = initialize();
        p = new(printer);
        p.run(3);
        return 0;
    end
}
