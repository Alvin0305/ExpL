class
    printer{
        decl
            int x;
            int print(int v);
        enddecl

        int print(int v){
            decl enddecl
            begin
                write(v);
                return 1;
            end
        }
    }
endclass

decl
enddecl

int main(){
    decl
        printer p;
    enddecl
    begin
        initialize();
        p = new(printer);
        p.x = 42;
        p.print(p.x);
        return 0;
    end
}
