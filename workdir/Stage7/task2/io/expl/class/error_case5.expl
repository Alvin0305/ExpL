class
    node {
        decl
            int value;
            node next;
            void print();
        enddecl

        void print() {
            decl
            enddecl
            begin
                write(self.value);
            end
        }
    }
endclass

decl
enddecl

int main() {
    decl
        node n;
    enddecl

    begin
        n = new(node);
        n.value = 10;
        n.prin();
        n.next = new(node);
        n.next.next = new(node);
        write(n.value);

        n.next.next.prin();
    end
}