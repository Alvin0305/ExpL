class
    counter{
        decl
            int x;
            int inc();
        enddecl

        int inc(){
            decl enddecl
            begin
                self.x = self.x + 1;
                write(self.x);
                return 1;
            end
        }
    }
endclass

decl enddecl

int main(){
    decl
        counter c1;
        counter c2;
    enddecl
    begin
        initialize();
        c1 = new(counter);
        brkp;
        c2 = new(counter);

        brkp;
        c1.x = 0;
        c2.x = 10;

        brkp;
        c1.inc();
        c2.inc();
        c1.inc();
        return 0;
    end
}
