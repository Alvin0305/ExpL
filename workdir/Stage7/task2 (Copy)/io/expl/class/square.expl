class
    square{
        decl
            int k;
            int sq(int x);
        enddecl

        int sq(int x){
            decl enddecl
            begin
                return x * x;
            end
        }
    }
endclass

decl
    square s;
enddecl

int main(){
    decl
        int r;
    enddecl
    begin
        r = initialize();
        s = new(square);
        r = s.sq(7);
        write(r);
        return 0;
    end
}
