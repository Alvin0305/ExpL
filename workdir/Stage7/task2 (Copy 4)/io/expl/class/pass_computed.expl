class
    calc{
        decl
            int x;
            int f(int v);
        enddecl

        int f(int v){
            decl enddecl
            begin
                write(v);
                return 1;
            end
        }
    }
endclass

decl
    calc c;
enddecl

int main(){
    decl enddecl
    begin
        initialize();
        c = new(calc);
        c.x = 5;
        c.f(c.x + 3);
        return 0;
    end
}
