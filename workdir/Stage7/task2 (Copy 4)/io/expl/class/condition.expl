class
    cmp{
        decl
            int check(int x);
        enddecl

        int check(int x){
            decl enddecl
            begin
                if (x > 0) then
                    write(1);
                else
                    write(0);
                endif
                return 1;
            end
        }
    }
endclass

decl
    cmp c;
enddecl

int main(){
    decl
        int x; 
    enddecl
    begin
        x = initialize();
        c = new(cmp);
        c.check(5);
        c.check(0);
        return 0;
    end
}
