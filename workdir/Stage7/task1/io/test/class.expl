class
    Person {
        decl
            str name;
            int age;

            int printPerson();
            str findName();
            int createPerson(str name, int age);
        enddecl

        int printPerson() {
            decl
            enddecl

            begin
                write(self.findName());
                write(self.age);
                return 1;
            end
        }

        str findName() {
            decl enddecl
            begin
                return self.name;
            end
        }

        int createPerson(str name, int age) {
            decl enddecl
            begin
                self.name = "Alvin";
                self.age = 10;
                return 1;
            end
        }
    }
endclass

decl
