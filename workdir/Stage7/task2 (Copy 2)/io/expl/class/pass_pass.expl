class
    chain{
        decl
            int x;
            int a(int v);
            int b();
        enddecl

        int a(int v){
            decl enddecl
            begin
                write(v);
                return 1;
            end
        }

        int b(){
            decl enddecl
            begin
                self.x = 7;
                self.a(self.x);
                return 1;
            end
        }
    }
endclass

decl
    chain c;
enddecl

int main(){
    decl
    enddecl
    begin
        initialize();
        c = new(chain);
        c.b();
        return 0;
    end
}
