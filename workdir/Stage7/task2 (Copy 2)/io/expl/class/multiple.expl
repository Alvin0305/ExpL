class
    counter{
        decl
            int x;
            int inc();
        enddecl

        int inc(){
            decl enddecl
            begin
                self.x = self.x + 1;
                write(self.x);
                return self.x;
            end
        }
    }
endclass

decl
    counter c1, c2;
enddecl

int main(){
    decl
        int x; 
    enddecl
    begin
        x = initialize();
        c1 = new(counter);
        c2 = new(counter);
        c1.x = 0;
        c2.x = 10;
        c1.inc();
        c2.inc();
        c1.inc();
        return 0;
    end
}
