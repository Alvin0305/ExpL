class
    chain{
        decl
            int a();
            int b();
        enddecl

        int a(){
            decl enddecl
            begin
                return self.b();
            end
        }

        int b(){
            decl enddecl
            begin
                write(42);
                return 1;
            end
        }
    }
endclass

decl
    chain c;
enddecl

int main(){
    decl 
        int x;
    enddecl
    begin
        x = initialize();
        c = new(chain);
        c.a();
        return 0;
    end
}
