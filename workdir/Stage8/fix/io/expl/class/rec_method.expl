class
    down{
        decl
            int x;
            int go(int n);
        enddecl

        int go(int n){
            decl enddecl
            begin
                if (n == 0) then
                    return 1;
                endif
                write(n);
                return self.go(n - 1);
            end
        }
    }
endclass

decl
    down d;
enddecl

int main(){
    decl enddecl
    begin
        initialize();
        d = new(down);
        d.x = 3;
        d.go(d.x);
        return 0;
    end
}
