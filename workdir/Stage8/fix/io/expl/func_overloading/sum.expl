decl
    int sum(int a);
    int sum(int a, int b);
enddecl

int sum(int a) {
    decl
    enddecl
    begin
        return a;
    end
}

int sum(int a, int b) {
    decl
    enddecl
    begin
        return a + b;
    end
}

int main() {
    decl
        int x;
    enddecl
    begin
        x = sum(5);
        write(x);
        x = sum(5, 7);
        write(x);
    end
}
