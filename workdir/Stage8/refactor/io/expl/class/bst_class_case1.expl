type
    bst{
        int a;
        bst left;
        bst right;
    }
endtype

class
    bstclass{
        decl
            bst root;
            bst newnode(int key);
            bst insert(bst h, int key);
            int inorder(bst h);
        enddecl

        bst newnode(int key){
            decl
                bst t;
            enddecl
            begin
                t = alloc();
                t.a = key;
                t.left = NULL;
                t.right = NULL;
                return t;
            end
        }

        bst insert(bst h, int key){
            decl enddecl
            begin
                if (h == NULL) then
                    return self.newnode(key);
                else if (key < h.a) then
                    h.left = self.insert(h.left, key);
                else if (key > h.a) then
                    h.right = self.insert(h.right, key);
                endif
                endif
                endif
                return h;
            end
        }

        int inorder(bst h){
            decl enddecl
            begin
                if (h != NULL) then
                    self.inorder(h.left);
                    write(h.a);
                    self.inorder(h.right);
                endif
                return 1;
            end
        }
    }
endclass

decl
    bstclass obj;
enddecl

int main() {
    decl
        int val;
    enddecl
    begin
        val = initialize();
        obj = new(bstclass);
        obj.root = NULL;

        read(val);
        while (val != 0) do
            obj.root = obj.insert(obj.root, val);
            read(val);
        endwhile

        obj.inorder(obj.root);
        return 0;
    end
}
