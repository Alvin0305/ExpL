class
    pair{
        decl
            int a;
            int b;
            int sum(int x, int y);
        enddecl

        int sum(int x, int y){
            decl enddecl
            begin
                write(x + y);
                return 1;
            end
        }
    }
endclass

decl
    pair p;
enddecl

int main(){
    decl enddecl
    begin
        initialize();
        p = new(pair);
        p.a = 10;
        p.b = 20;
        p.sum(p.a, p.b);
        return 0;
    end
}
