class
    acc{
        decl
            int sum;
            int add(int x);
        enddecl

        int add(int x){
            decl enddecl
            begin
                self.sum = self.sum + x;
                write(self.sum);
                return self.sum;
            end
        }
    }
endclass

decl
    acc a;
enddecl

int main(){
    decl 
        int x;
    enddecl
    begin
        x = initialize();
        a = new(acc);
        a.sum = 0;
        a.add(10);
        a.add(5);
        a.add(15);
        return 0;
    end
}
