class
A {
    decl
        int f();
        int g();
    enddecl

    int f() {
        decl
        enddecl
        begin
            return 1;
        end
    }

    int g() {
        decl
        enddecl
        begin
            return 2;
        end
    }
}

B extends A {
    decl
        int f();
    enddecl

    int f() {
        decl
        enddecl
        begin
            return 10;
        end
    }
}
endclass

decl
    A p;
enddecl

int main() {
    decl
        int temp;
    enddecl
    begin
        temp = initialize();
        p = new(B);
        write(p.f());
        write(p.g());
    end
}
